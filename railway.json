{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @carelink/database db:generate && pnpm build",
    "watchPatterns": [
      "apps/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      "turbo.json",
      "nixpacks.toml",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "PORT=3000 node packages/api/dist/index.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
