// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app_auth", "core", "messaging", "analytics", "billing", "audit", "vrs", "marketplace"]
}

// ============================================
// AUTH SCHEMA
// ============================================

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  emailVerified  DateTime?
  password       String? // Hashed
  firstName      String
  lastName       String
  phone          String?
  phoneVerified  DateTime?
  role           UserRole
  status         UserStatus    @default(PENDING_VERIFICATION)
  profileImage   String? // Profile picture URL
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Relations
  auditLogs               AuditLog[]
  notifications           Notification[]
  messages                Message[]
  referrals               Referral[]
  dischargeCases          DischargeCase[]
  consents                Consent[]
  supportTickets          SupportTicket[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  favorites               Favorite[]
  publicReferralRequests  PublicReferralRequest[]
  assignedRequests        PublicReferralRequest[] @relation("AssignedRequests")

  @@index([email])
  @@index([organizationId])
  @@index([role])
  @@schema("app_auth")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PROVIDER_OWNER
  PROVIDER_STAFF
  CASE_MANAGER
  HOSPITAL_SW
  VRS_SPECIALIST
  VENDOR
  PUBLIC

  @@schema("app_auth")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("app_auth")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@schema("app_auth")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@schema("app_auth")
}

model Organization {
  id         String             @id @default(uuid())
  name       String
  type       OrganizationType
  ein        String?            @unique // Employer ID
  npi        String?            @unique // National Provider ID
  status     OrganizationStatus @default(PENDING)
  verifiedAt DateTime?
  verifiedBy String?

  // Contact Info
  email   String
  phone   String
  fax     String?
  website String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  county       String

  // Settings
  settings Json @default("{}")

  // Branding
  logo       String? // Organization logo URL
  coverImage String? // Organization cover/banner image URL

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  providers        Provider[]
  caseManagers     CaseManager[]
  hospitalStaff    HospitalStaff[]
  vendors          Vendor[]


  @@index([type])
  @@index([status])
  @@schema("app_auth")
}

model CaseManager {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Profile
  firstName String
  lastName  String
  email     String  @unique
  phone     String?

  // License info
  licenseNumber      String?
  licenseExpiry      DateTime?
  licenseDocumentUrl String? // URL to license document
  licenseFileName    String? // Original filename of license document

  // Settings
  isActive                Boolean @default(true)
  notificationPreferences Json? // Store notification preferences as JSON
  defaultReferralSettings Json? // Store default referral settings as JSON

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  referrals Referral[]

  @@index([organizationId])
  @@index([email])
  @@schema("core")
}

model HospitalStaff {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Profile
  firstName String
  lastName  String
  email     String  @unique
  phone     String?

  // Department info
  department String?
  title      String?

  // Settings
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dischargeCases DischargeCase[]

  @@index([organizationId])
  @@index([email])
  @@schema("core")
}

enum OrganizationType {
  PROVIDER
  CASE_MANAGEMENT
  HOSPITAL
  VRS
  VENDOR

  @@schema("app_auth")
}

enum OrganizationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  DEACTIVATED

  @@schema("app_auth")
}

// ============================================
// CORE SCHEMA - PROVIDERS
// ============================================

model Provider {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Licensing
  licenses           License[]
  primaryLicenseType String

  // Subscription
  subscriptionTier SubscriptionTier @default(FREE)
  subscriptionId   String?

  // Verification
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  verificationNotes String?

  // Profile
  description String? @db.Text
  logo        String? // URL
  coverImage  String? // URL

  // Settings
  acceptsReferrals  Boolean @default(true)
  responseTimeHours Int? // Average response time

  // Paid Boost Fields
  boostLevel        Int       @default(0) // 0 = no boost, 1-3 = boost levels
  boostExpiresAt    DateTime?
  boostPurchasedAt  DateTime?
  boostStripeSubId  String?   // Stripe subscription ID for recurring boosts

  // Metrics for analytics
  viewCount         Int       @default(0)
  inquiryCount      Int       @default(0)
  placementCount    Int       @default(0)
  lastViewedAt      DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  homes            Home[]
  services         ProviderService[]
  openings         Opening[]
  messages         MessageThread[]
  placements       Placement[]
  analyticsEvents  AnalyticsEvent[]
  onboardingState  ProviderOnboardingState?
  favorites        Favorite[]
  boostPurchases   BoostPurchase[]

  @@index([organizationId])
  @@index([subscriptionTier])
  @@index([verified])
  @@index([boostLevel, boostExpiresAt])
  @@index([viewCount])
  @@schema("core")
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
  ENTERPRISE

  @@schema("core")
}

model License {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  licenseType   String // e.g., "144D", "245D", "CRS", "ALF"
  licenseNumber String

  issueDate      DateTime
  expirationDate DateTime

  status     LicenseStatus @default(PENDING)
  verifiedAt DateTime?
  verifiedBy String?

  // Documents
  documentUrl String? // Encrypted URL
  fileName    String? // Original filename of license document

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([licenseNumber])
  @@index([providerId])
  @@index([expirationDate])
  @@index([status])
  @@schema("core")
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED

  @@schema("core")
}

model ProviderOnboardingState {
  id         String   @id @default(uuid())
  providerId String   @unique
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Step Progress
  currentStep    Int   @default(0)
  completedSteps Int[] @default([])

  // Step Data (JSON for flexibility)
  organizationData Json? @default("{}")
  licenseData      Json? @default("{}")
  serviceData      Json? @default("{}")
  subscriptionData Json? @default("{}")

  // Status
  isComplete  Boolean   @default(false)
  submittedAt DateTime?

  // Admin Review
  adminReviewStatus OnboardingReviewStatus @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([adminReviewStatus])
  @@schema("core")
}

enum OnboardingReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_CHANGES

  @@schema("core")
}

model Home {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Basic Info
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String  @default("MN")
  zipCode      String
  county       String

  // Geolocation
  latitude  Float
  longitude Float
  location  String? // Will be converted to geography when PostGIS is available

  // Details
  capacity         Int // Total beds/spots
  currentOccupancy Int @default(0)

  // Features
  wheelchairAccessible Boolean @default(false)
  singleLevel          Boolean @default(false)
  hasElevator          Boolean @default(false)
  hasRollInShower      Boolean @default(false)

  // Media
  photos         HomePhoto[]
  virtualTourUrl String?

  // Settings
  acceptingNew Boolean @default(true)
  isActive     Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  services  HomeService[]
  openings  Opening[]
  amenities HomeAmenity[]

  @@index([providerId])
  @@index([county])
  @@index([zipCode])
  @@index([isActive])
  @@schema("core")
}

model HomePhoto {
  id        String   @id @default(uuid())
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([homeId])
  @@schema("core")
}

// ============================================
// CORE SCHEMA - SERVICES
// ============================================

model Service {
  id           String   @id @default(uuid())
  code         String   @unique // e.g., "ADL_ASSIST"
  name         String
  description  String?
  category     String // e.g., "Daily Living", "Medical"
  licenseTypes String[] // Which licenses can offer this

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  providerServices ProviderService[]
  homeServices     HomeService[]

  @@index([category])
  @@index([isActive])
  @@schema("core")
}

model ProviderService {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([providerId, serviceId])
  @@index([providerId])
  @@index([serviceId])
  @@schema("core")
}

model HomeService {
  id        String  @id @default(uuid())
  homeId    String
  home      Home    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([homeId, serviceId])
  @@index([homeId])
  @@index([serviceId])
  @@schema("core")
}

model HomeAmenity {
  id          String  @id @default(uuid())
  homeId      String
  home        Home    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  amenityType String // e.g., "outdoor_space", "pet_friendly"
  description String?

  @@index([homeId])
  @@schema("core")
}

// ============================================
// CORE SCHEMA - OPENINGS
// ============================================

model Opening {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)

  // Availability
  spotsAvailable Int
  availableFrom  DateTime
  availableUntil DateTime?

  // Requirements
  ageMin           Int?
  ageMax           Int?
  genderPreference Gender?

  // Care Levels
  careLevels     String[] // e.g., ["BASIC", "INTENSIVE"]
  supportedNeeds String[] // e.g., ["MOBILITY", "MEMORY_CARE"]

  // Payers
  acceptedPayers Payer[]
  privatePayRate Decimal? @db.Decimal(10, 2)

  // Status
  status               OpeningStatus @default(OPEN)
  freshnessTimestamp   DateTime      @default(now())
  // Reminder
  expiryReminderSentAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  placements Placement[]

  @@index([providerId])
  @@index([homeId])
  @@index([status])
  @@index([freshnessTimestamp])
  @@index([acceptedPayers])
  @@index([expiryReminderSentAt])
  @@schema("core")
}

enum OpeningStatus {
  OPEN
  PENDING
  FILLED
  EXPIRED

  @@schema("core")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NO_PREFERENCE

  @@schema("core")
}

enum Payer {
  MA // Medical Assistance
  MEDICARE
  PRIVATE
  CADI // Community Access for Disability Inclusion
  BI_TBI // Brain Injury / Traumatic Brain Injury
  EW // Elderly Waiver
  DD // Developmental Disabilities

  @@schema("core")
}

// ============================================
// CORE SCHEMA - REFERRALS
// ============================================

model Referral {
  id             String @id @default(uuid())
  referralNumber String @unique @default(cuid())

  // Case Manager
  caseManagerId        String
  caseManager          User         @relation(fields: [caseManagerId], references: [id], onDelete: Cascade)
  caseManagerProfileId String?
  caseManagerProfile   CaseManager? @relation(fields: [caseManagerProfileId], references: [id], onDelete: SetNull)
  organizationId       String

  // Client (De-identified)
  clientAge      Int
  clientGender   Gender
  clientInitials String // First + Last initial only

  // Needs
  careLevels      String[]
  servicesNeeded  String[]
  mobilityLevel   String? // e.g., "AMBULATORY", "WHEELCHAIR"
  behavioralNeeds String[]
  medicalNeeds    String[]

  // Preferences
  preferredCounties String[]
  preferredCities   String[]
  maxDistance       Int? // Miles from preferred location

  // Payer
  primaryPayer   Payer
  secondaryPayer Payer?

  // Timeline
  targetMoveDate DateTime?
  urgency        Urgency   @default(ROUTINE)

  // Status
  status ReferralStatus @default(NEW)

  // Notes
  internalNotes String? @db.Text

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  placedAt  DateTime?
  closedAt  DateTime?

  // Relations
  shortlist             ReferralShortlist[]
  messages              MessageThread[]
  placements            Placement[]
  publicReferralRequest PublicReferralRequest?

  @@index([caseManagerId])
  @@index([status])
  @@index([urgency])
  @@index([primaryPayer])
  @@schema("core")
}

enum Urgency {
  URGENT // < 48 hours
  HIGH // < 1 week
  ROUTINE // > 1 week

  @@schema("core")
}

enum ReferralStatus {
  NEW
  IN_REVIEW
  TOURING
  OFFER_MADE
  PLACED
  CLOSED
  CANCELLED

  @@schema("core")
}

model ReferralShortlist {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  providerId String

  status      ShortlistStatus @default(ADDED)
  addedAt     DateTime        @default(now())
  contactedAt DateTime?
  respondedAt DateTime?

  notes String?

  @@unique([referralId, providerId])
  @@index([referralId])
  @@index([status])
  @@schema("core")
}

enum ShortlistStatus {
  ADDED
  CONTACTED
  RESPONDED
  TOURING
  DECLINED

  @@schema("core")
}

// ============================================
// CORE SCHEMA - PUBLIC REFERRAL REQUESTS
// ============================================

model PublicReferralRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique @default(cuid())

  // Requester (Family Member - PUBLIC role)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Contact Info
  contactName  String
  contactEmail String
  contactPhone String?

  // Care Recipient (De-identified)
  recipientAge      Int
  recipientGender   Gender
  recipientInitials String // First + Last initial

  // Needs Description
  careNeeds         String   @db.Text // Free-form description
  urgency           Urgency  @default(ROUTINE)
  preferredCounties String[]

  // Payer Information
  primaryPayer   Payer?
  secondaryPayer Payer?

  // Provider Interest (optional)
  interestedProviderIds String[] // Providers they're considering

  // Status & Assignment
  status                RequestStatus @default(PENDING)
  assignedCaseManagerId String?
  assignedCaseManager   User?         @relation("AssignedRequests", fields: [assignedCaseManagerId], references: [id], onDelete: SetNull)
  assignedAt            DateTime?

  // Conversion to Referral
  convertedToReferralId String?   @unique
  convertedToReferral   Referral? @relation(fields: [convertedToReferralId], references: [id], onDelete: SetNull)
  convertedAt           DateTime?

  // Notes
  internalNotes String? @db.Text // Case manager notes

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([userId])
  @@index([status])
  @@index([assignedCaseManagerId])
  @@schema("core")
}

enum RequestStatus {
  PENDING     // Awaiting assignment
  ASSIGNED    // Case manager assigned
  IN_PROGRESS // Case manager working on it
  CONVERTED   // Converted to formal referral
  CLOSED      // Closed without conversion
  CANCELLED   // User cancelled

  @@schema("core")
}

// ============================================
// CORE SCHEMA - HOSPITAL DISCHARGE
// ============================================

model DischargeCase {
  id         String @id @default(uuid())
  caseNumber String @unique @default(cuid())

  // Hospital & Social Worker
  hospitalId      String
  socialWorkerId  String
  socialWorker    User           @relation(fields: [socialWorkerId], references: [id], onDelete: Cascade)
  hospitalStaffId String?
  hospitalStaff   HospitalStaff? @relation(fields: [hospitalStaffId], references: [id], onDelete: SetNull)

  // Patient (Minimal PHI)
  patientInitials String
  patientAge      Int
  patientGender   Gender

  // Medical
  diagnosisCodes     String[] // ICD-10 codes
  mobilityStatus     String
  cognitiveStatus    String?
  behavioralConcerns String[]

  // Equipment Needs
  dmeNeeds             String[] // Durable Medical Equipment
  medicationManagement Boolean

  // Discharge Planning
  currentLocation     String // e.g., "ICU", "Medical Floor"
  targetDischargeDate DateTime
  actualDischargeDate DateTime?

  // Geography
  preferredCounties String[]
  preferredCities   String[]
  requiresProximity Boolean  @default(false)
  proximityZipCode  String?
  maxDistanceMiles  Int?

  // Payer
  primaryInsurance   Payer
  secondaryInsurance Payer?

  // Status
  status DischargeStatus @default(INTAKE)

  // Transport
  needsTransport Boolean @default(false)
  transportType  String? // e.g., "AMBULANCE", "WHEELCHAIR_VAN"

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  matchedAt     DateTime?
  invitesSentAt DateTime?
  placedAt      DateTime?

  // Relations
  invitations      DischargeInvitation[]
  messages         MessageThread[]
  placement        Placement?
  transportBooking TransportBooking?
  checklist        DischargeChecklist?
  consent          Consent?

  @@index([hospitalId])
  @@index([socialWorkerId])
  @@index([status])
  @@index([targetDischargeDate])
  @@schema("core")
}

enum DischargeStatus {
  INTAKE
  MATCHING
  INVITES_SENT
  RESPONSES_PENDING
  PLACEMENT_CONFIRMED
  DISCHARGED
  FOLLOW_UP
  COMPLETED
  CANCELLED

  @@schema("core")
}

model DischargeInvitation {
  id              String        @id @default(uuid())
  dischargeCaseId String
  dischargeCase   DischargeCase @relation(fields: [dischargeCaseId], references: [id], onDelete: Cascade)
  providerId      String

  invitedAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  response      InviteResponse?
  responseNotes String?

  reminderSentAt DateTime?
  escalatedAt    DateTime?

  @@index([dischargeCaseId])
  @@index([providerId])
  @@index([expiresAt])
  @@schema("core")
}

enum InviteResponse {
  ACCEPTED
  DECLINED
  NO_AVAILABILITY

  @@schema("core")
}

model DischargeChecklist {
  id              String        @id @default(uuid())
  dischargeCaseId String        @unique
  dischargeCase   DischargeCase @relation(fields: [dischargeCaseId], references: [id], onDelete: Cascade)

  // Pre-discharge
  consentObtained   Boolean @default(false)
  insuranceVerified Boolean @default(false)
  medsReconciled    Boolean @default(false)
  equipmentOrdered  Boolean @default(false)
  transportArranged Boolean @default(false)

  // During discharge
  patientEducated   Boolean @default(false)
  documentsSent     Boolean @default(false)
  followUpScheduled Boolean @default(false)

  // Post-discharge
  day1Contact  Boolean @default(false)
  day2Contact  Boolean @default(false)
  day7Contact  Boolean @default(false)
  day30Contact Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@schema("core")
}

// ============================================
// CORE SCHEMA - PLACEMENTS
// ============================================

model Placement {
  id String @id @default(uuid())

  // References
  referralId      String?
  referral        Referral?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  dischargeCaseId String?        @unique
  dischargeCase   DischargeCase? @relation(fields: [dischargeCaseId], references: [id], onDelete: SetNull)

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  openingId  String
  opening    Opening  @relation(fields: [openingId], references: [id], onDelete: Cascade)

  // Details
  placementDate DateTime
  moveInDate    DateTime?

  // Status
  status PlacementStatus @default(PENDING)

  // Packet
  packetGeneratedAt DateTime?
  packetUrl         String? // Signed URL with TTL
  packetAccessLog   PacketAccessLog[]

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?

  // Relations for new features
  followUps      PlacementFollowUp[]
  documents      PlacementDocument[]
  familyContacts PlacementFamilyContact[]
  updates        PlacementUpdate[]

  @@index([referralId])
  @@index([dischargeCaseId])
  @@index([providerId])
  @@index([status])
  @@schema("core")
}

enum PlacementStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("core")
}

model PlacementFollowUp {
  id          String   @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  
  type        FollowUpType
  scheduledAt DateTime
  completedAt DateTime?
  completedBy String?
  
  notes       String? @db.Text
  outcome     FollowUpOutcome?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([placementId])
  @@index([scheduledAt])
  @@index([completedAt])
  @@schema("core")
}

enum FollowUpType {
  DAY_1_CHECKIN
  DAY_7_CHECKIN
  DAY_30_CHECKIN
  DAY_90_CHECKIN
  CUSTOM
  
  @@schema("core")
}

enum FollowUpOutcome {
  POSITIVE
  CONCERNS
  NEEDS_ATTENTION
  NO_RESPONSE
  
  @@schema("core")
}

model PlacementDocument {
  id          String   @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileType    String
  fileSize    Int
  category    DocumentCategory
  
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  
  storageUrl  String
  expiresAt   DateTime?
  
  notes       String?
  
  @@index([placementId])
  @@index([category])
  @@schema("core")
}

enum DocumentCategory {
  MEDICAL_RECORDS
  INSURANCE
  IDENTIFICATION
  CARE_PLAN
  CONSENT_FORM
  PHOTO
  OTHER
  
  @@schema("core")
}

model PlacementFamilyContact {
  id          String   @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  
  name        String
  relationship String
  email       String
  phone       String?
  
  isPrimary   Boolean @default(false)
  canReceiveUpdates Boolean @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([placementId])
  @@schema("core")
}

model PlacementUpdate {
  id          String   @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  
  title       String
  message     String @db.Text
  category    UpdateCategory
  
  createdBy   String
  createdAt   DateTime @default(now())
  
  photos      String[]
  
  @@index([placementId])
  @@index([createdAt])
  @@schema("core")
}

enum UpdateCategory {
  GENERAL
  HEALTH
  ACTIVITY
  MILESTONE
  PHOTO
  
  @@schema("core")
}

model PacketAccessLog {
  id          String    @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  accessedBy String // User ID
  accessedAt DateTime @default(now())
  ipAddress  String
  userAgent  String?

  @@index([placementId])
  @@index([accessedBy])
  @@schema("audit")
}

// ============================================
// MESSAGING SCHEMA
// ============================================

model MessageThread {
  id String @id @default(uuid())

  // Context
  referralId      String?
  referral        Referral?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  dischargeCaseId String?
  dischargeCase   DischargeCase? @relation(fields: [dischargeCaseId], references: [id], onDelete: SetNull)

  // Participants
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  initiatorId String

  // Status
  status ThreadStatus @default(OPEN)

  // SLA Tracking
  firstResponseAt DateTime?
  avgResponseTime Int? // In minutes

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  closedAt      DateTime?

  // Relations
  messages Message[]

  @@index([referralId])
  @@index([dischargeCaseId])
  @@index([providerId])
  @@index([status])
  @@schema("messaging")
}

enum ThreadStatus {
  OPEN
  AWAITING_RESPONSE
  RESOLVED
  CLOSED

  @@schema("messaging")
}

model Message {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String @db.Text

  // Attachments
  attachments MessageAttachment[]

  // Read receipts
  isRead Boolean   @default(false)
  readAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([threadId])
  @@index([senderId])
  @@schema("messaging")
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  fileType String
  fileSize Int // In bytes
  url      String // Signed URL

  createdAt DateTime @default(now())

  @@index([messageId])
  @@schema("messaging")
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String           @db.Text

  // Metadata for rich notifications
  metadata Json? // Additional data (referralId, providerId, requestId, etc.)

  // Action
  actionUrl   String? // URL to navigate to
  actionLabel String? // Button text (e.g., "View Request", "Respond")

  // Delivery
  channels String[] @default(["IN_APP"]) // ["EMAIL", "SMS", "IN_APP"]

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Email/SMS status
  emailSentAt DateTime?
  smsSentAt   DateTime?

  // Expiry (auto-delete old notifications)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@schema("messaging")
}

enum NotificationType {
  // PUBLIC (Family Member)
  REQUEST_ASSIGNED      // Case manager assigned to request
  REQUEST_STATUS_UPDATE // Request status changed
  REQUEST_CONVERTED     // Request converted to referral

  // CASE_MANAGER
  NEW_REFERRAL_REQUEST // New request from PUBLIC user
  PROVIDER_RESPONSE    // Provider responded to message
  PLACEMENT_UPDATE     // Placement status changed
  URGENT_CASE_ALERT    // Urgent case needs attention

  // PROVIDER
  NEW_REFERRAL                  // New referral added to shortlist
  MESSAGE_RECEIVED              // New message
  OPENING_EXPIRING              // Opening about to expire
  PLACEMENT_CONFIRMED           // Placement confirmed
  DISCHARGE_INVITATION_RECEIVED // Invited to discharge case

  // HOSPITAL_SW
  DISCHARGE_INVITE_RESPONSE // Provider responded to invite
  DISCHARGE_PLACEMENT       // Placement confirmed for discharge

  // VENDOR
  NEW_LEAD           // New lead received
  BOOKING_CONFIRMED  // Booking confirmed
  BOOKING_COMPLETED  // Booking completed

  // VRS_SPECIALIST
  CLIENT_UPDATE     // Client status changed
  JOB_MATCH         // New job match for client
  RETENTION_ALERT   // Retention check-in due
  PLACEMENT_SUCCESS // Placement successful

  // SYSTEM
  SYSTEM_ANNOUNCEMENT // System-wide announcement
  ACCOUNT_UPDATE      // Account/profile update
  LICENSE_EXPIRING    // License expiring soon

  // Legacy (keep for compatibility)
  REFERRAL_NEW
  REFERRAL_UPDATE
  MESSAGE_NEW
  INVITE_RECEIVED
  INVITE_EXPIRING

  // PLACEMENT ENHANCEMENTS
  FOLLOW_UP_REMINDER
  FOLLOW_UP_DUE
  FOLLOW_UP_OVERDUE
  DOCUMENT_EXPIRING_SOON
  DOCUMENT_EXPIRED

  @@schema("messaging")
}


// ============================================
// ANALYTICS SCHEMA
// ============================================

model AnalyticsEvent {
  id String @id @default(uuid())

  eventType EventType
  userId    String?
  sessionId String?

  // Context
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  referralId String?

  // Event Data
  eventData Json @default("{}")

  // User Info
  ipAddress String?
  userAgent String?
  referer   String?

  // Location
  country String?
  region  String?
  city    String?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
  @@schema("analytics")
}

enum EventType {
  // Search events
  SEARCH_PERFORMED
  SEARCH_FILTER_APPLIED

  // Provider events
  PROVIDER_VIEWED
  PROVIDER_CONTACTED
  PROVIDER_FAVORITED

  // Referral events
  REFERRAL_CREATED
  REFERRAL_UPDATE
  REFERRAL_SHORTLIST_ADDED
  REFERRAL_MESSAGE_SENT

  // Placement events
  PLACEMENT_INITIATED
  PLACEMENT_CONFIRMED
  PLACEMENT_COMPLETED

  // User events
